      "function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;'); } let ws; let reconnectTimer; var statusDot = document.getElementById('status-dot'); function connect() { ws = new WebSocket('ws://127.0.0.1:${wsPort}', ['governance-v1', '${sessionToken}']); ws.onopen = function() { statusDot.classList.remove('disconnected'); }; ws.onclose = function() { statusDot.classList.add('disconnected'); scheduleReconnect(); }; ws.onerror = function() { ws.close(); }; ws.onmessage = function(event) { handleMessage(JSON.parse(event.data)); }; } function scheduleReconnect() { if (reconnectTimer) { clearTimeout(reconnectTimer); } reconnectTimer = setTimeout(connect, 3000); } function handleMessage(msg) { if (msg.type === 'sloUpdate') { updateSLO(msg.data); } else if (msg.type === 'topologyUpdate') { updateTopology(msg.data); } else if (msg.type === 'auditUpdate') { updateAudit(msg.data); } else if (msg.type === 'policyUpdate') { updatePolicies(msg.data); } }"
